# EchoLoop environment configuration (EXAMPLE)
#
# Copy to `.env` and fill in real values locally. NEVER commit `.env`.
# No real secret may ever appear in this example file.

# --- Runtime ---
NODE_ENV=development

# --- Web application ---
# The local MVP binds to localhost by default. Do not expose publicly.
WEB_HOST=127.0.0.1
WEB_PORT=3000

# --- PostgreSQL (Phase 1) ---
DATABASE_URL=postgres://echoloop:echoloop@127.0.0.1:5432/echoloop

# --- Encryption (Phase 1) ---
# Local at-rest encryption key (base64, 32 bytes). Generate locally; never commit.
ENCRYPTION_KEY=

# --- Google OAuth / Gmail (Phase 2) ---
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://127.0.0.1:3000/oauth/google/callback

# --- Anthropic API (Phase 3+) ---
ANTHROPIC_API_KEY=

# --- Safety controls ---
# Activation mode: disabled | dry_run | allowlist | enabled
ECHOLOOP_ACTIVATION_MODE=disabled
# Global drafting kill switch. When true, no drafts are ever created.
ECHOLOOP_DRAFTING_KILL_SWITCH=true
