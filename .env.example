# EchoLoop environment configuration (EXAMPLE)
#
# Copy to `.env` and fill in real values locally. NEVER commit `.env`.
# No real secret may ever appear in this example file.

# --- Runtime ---
NODE_ENV=development

# --- Web application ---
# The local MVP binds to localhost by default. Do not expose publicly.
WEB_HOST=127.0.0.1
WEB_PORT=3000

# --- PostgreSQL (Phase 1) ---
DATABASE_URL=postgres://echoloop:echoloop@127.0.0.1:5432/echoloop

# --- Encryption (Phase 1) ---
# Local at-rest encryption key (base64, 32 bytes). Generate locally; never commit.
ENCRYPTION_KEY=

# --- Google OAuth / Gmail (Phase 2) ---
# Path to the downloaded Desktop-app OAuth client JSON. MUST resolve OUTSIDE
# this repository (enforced in code) so the client secret can never be
# committed by accident. Default: ~/.echoloop/credentials.json
GOOGLE_CREDENTIALS_PATH=
# Note: while the Google consent screen is in Testing status, refresh tokens
# expire after ~7 days. EchoLoop detects this and moves the account to a
# "reconnect_required" state; rerun the connect CLI to re-consent.
# Scopes are fixed in code (gmail.readonly + gmail.compose) and are not
# configurable here.

# --- Anthropic API (Phase 3+) ---
ANTHROPIC_API_KEY=
# Model IDs (env-configurable; see docs/DECISIONS.md D-012)
ANTHROPIC_MODEL_CLASSIFICATION=claude-haiku-4-5
ANTHROPIC_MODEL_DRAFTING=claude-opus-4-8
ANTHROPIC_MODEL_COMPARISON=claude-opus-4-8

# --- Safety controls ---
# Activation mode: disabled | dry_run | allowlist | enabled
ECHOLOOP_ACTIVATION_MODE=disabled
# Global drafting kill switch. When true, no drafts are ever created.
ECHOLOOP_DRAFTING_KILL_SWITCH=true
# Rate limits for Gmail draft creation
ECHOLOOP_MAX_DRAFTS_PER_HOUR=10
ECHOLOOP_MAX_DRAFTS_PER_CYCLE=3
